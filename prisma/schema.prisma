generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  modelSettings ModelSetting[]
  conversations Conversation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One row per (user, phase) -- which Claude model + effort tier to use
// for that phase of the PRD-writing conversation. See src/lib/modelSettings.ts
// for the phase list, allowed models, and defaults.
model ModelSetting {
  id     String  @id @default(cuid())
  userId String
  phase  String
  model  String
  effort String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phase])
}

// One row per PRD-writing conversation, draft or completed. "Revise" on a
// completed PRD creates a NEW row with parentId pointing at this one and
// version incremented -- never edits the original in place.
model Conversation {
  id              String    @id @default(cuid())
  userId          String
  title           String?
  status          String    @default("draft") // "draft" | "completed" | "archived"
  currentPhase    String    @default("objective")
  completedPhases String    @default("[]") // JSON-encoded Phase[]
  messages        String    @default("[]") // JSON-encoded ChatMessage[]
  verticals       String    @default("[]") // JSON-encoded string[], set via set_verticals at phase 4
  phaseLog        String    @default("[]") // JSON-encoded {phase, at}[], one entry per phase transition
  notes           String    @default("") // PM's own scratch notes, never sent to the model
  prdMarkdownPath String?
  googleDocUrl    String?
  version         Int       @default(1)
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Conversation?  @relation("Revisions", fields: [parentId], references: [id])
  revisions Conversation[] @relation("Revisions")

  @@index([userId, status])
}
