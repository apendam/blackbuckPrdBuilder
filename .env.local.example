# Copy this file to .env.local and fill in your key.
ANTHROPIC_API_KEY=
DATABASE_URL=file:./prisma/dev.db

# Local development only: there is no Cloudflare Access in front of `npm run dev`,
# so this is who the app treats you as. Ignored when NODE_ENV=production.
DEV_USER_EMAIL=you@blackbuck.com

# Deployed behind Cloudflare Access: verifies the Cf-Access-Jwt-Assertion token.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# Optional: only for the Google Docs export. Works only for a Google account that was
# linked before sign-in moved to Cloudflare; new users cannot link one.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
